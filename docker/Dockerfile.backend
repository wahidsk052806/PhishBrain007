FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies required by Python packages and Playwright.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install -r requirements.txt

# `--with-deps` installs the shared libraries Chromium links against (libnss3,
# libglib, libgbm, libasound, ...). Without it the browser downloads fine but
# refuses to launch inside this image, so every scan reported "Visual analysis:
# unavailable" with a BrowserType.launch library list instead of a screenshot.
RUN playwright install --with-deps chromium

COPY backend/ ./
COPY ml/ ./ml/
COPY data/ ./data/

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
