# Copy to deploy/.env and fill in. This file is what `compose.prod.yml` reads.
# Never commit the filled-in copy.

# --- infrastructure -----------------------------------------------------------
# Postgres is generated for you below; change it before the first boot.
POSTGRES_USER=phishbrain
POSTGRES_PASSWORD=change-me-long-random-string
POSTGRES_DB=phishbrain

# Cloudflare Zero Trust -> Networks -> Tunnels -> (your tunnel) -> Install
TUNNEL_TOKEN=eyJh...replace-with-your-tunnel-token

# --- model --------------------------------------------------------------------
# llama3.2:3b (~2 GB) is the largest model that answers a scan on a 4 vCPU box.
# 8B needs ~4.9 GB resident and took ~293 s per verdict there; only use it on
# 16 GB+ and raise LLM_TIMEOUT_SECONDS with it.
OLLAMA_MODEL=llama3.2:3b

# --- analysis budgets ---------------------------------------------------------
ANALYSIS_TIMEOUT_SECONDS=20.0
LLM_TIMEOUT_SECONDS=150.0
LLM_WARMUP_TIMEOUT_SECONDS=300.0
LLM_WARMUP_ON_STARTUP=true
LLM_KEEP_ALIVE=30m
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=320
LLM_WEBPAGE_SUMMARY_CHARS=1200
VISUAL_TIMEOUT_SECONDS=30.0
CACHE_TTL_SECONDS=3600

# --- capacity -----------------------------------------------------------------
# How many scans may use Chromium / the model at the same time. One each is
# right for 4 cores: more than that and every scan times out instead of one
# being slow. The rest queue for SCAN_QUEUE_TIMEOUT_SECONDS and then finish with
# the deterministic layers only, labelled `llm.busy` / `visual.busy`.
MAX_CONCURRENT_LLM_SCANS=1
MAX_CONCURRENT_VISUAL_SCANS=1
SCAN_QUEUE_TIMEOUT_SECONDS=20.0

# --- scoring ------------------------------------------------------------------
EMAIL_WEIGHT=0.30
URL_WEIGHT=0.30
DOMAIN_WEIGHT=0.20
WEBPAGE_WEIGHT=0.20
PREFILTER_WEIGHT=0.15
SAFE_THRESHOLD=30
SUSPICIOUS_THRESHOLD=65

# --- privacy on a shared box --------------------------------------------------
# A screenshot is a picture of a stranger's page: keep none of them by default.
# Use "wireframe" instead of "pixels" if you want the comparison visible but the
# text unreadable. "off" keeps pixels on the server and returns no image.
VISUAL_SCREENSHOT_MODE=wireframe
VISUAL_SCREENSHOT_MAX_WIDTH=480
VISUAL_RETENTION_DAYS=0
VISUAL_PURGE_INTERVAL_MINUTES=360
VISUAL_AUTO_PURGE_ENABLED=true
STORE_RAW_EMAIL=false
RETENTION_DAYS=30

# --- who may call the API -----------------------------------------------------
# Browser extensions (Chrome: chrome-extension://, Firefox: moz-extension://)
# plus your dashboard origin. Anything else — including an arbitrary internet
# page — is refused, so the backend cannot be borrowed as a free scanner.
# A public origin is NOT allowed by the built-in default regex; this override is
# what lets your own dashboard on Cloudflare call it.
CORS_ORIGIN_REGEX=^((?:chrome|moz)-extension://.*|https://(?:www\.)?phishbrain007\.app)$

BRAND_LIST=paypal,microsoft,apple,google,amazon,facebook,netflix,bankofamerica,chase,wellsfargo,dropbox,linkedin,instagram,docusign,adobe,outlook,office365
ALLOWED_SCHEMES=http,https
MAX_REQUEST_BYTES=2000000
MAX_FETCH_BYTES=3000000
