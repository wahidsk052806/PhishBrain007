# Application Settings
APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Infrastructure
DATABASE_URL=postgresql://phishbrain:phishbrain@postgres:5432/phishbrain
CACHE_URL=redis://valkey:6379/0

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# llama3.2:3b (~2 GB) is the largest model that answers acceptably on the
# documented 4 CPU / 8 GB host (measured warm: ~19 s per verdict). llama3.1:8b
# needs ~4.9 GB resident and took ~293 s for the same request there; use it only
# on a 16 GB machine and raise LLM_TIMEOUT_SECONDS with it.
OLLAMA_MODEL=llama3.2:3b

# Analysis Parameters
# Network-only layers: page fetch, RDAP/DNS/TLS, DOM read.
ANALYSIS_TIMEOUT_SECONDS=20.0
# The LLM gets its own, larger budget: CPU inference is tens of seconds even
# with a warm model, and sharing the network deadline cancelled every verdict.
# Measured on 4 vCPU / 8 GB: ~100 s per verdict with llama3.2:3b resident.
LLM_TIMEOUT_SECONDS=150.0
# One-off model load paid by the startup warm-up (8B measured ~97 s on 4 cores).
LLM_WARMUP_TIMEOUT_SECONDS=300.0
# Rendering budget for the screenshot/model comparison, Chromium launch included.
VISUAL_TIMEOUT_SECONDS=30.0
CACHE_TTL_SECONDS=3600

# Scoring Weights (Sum should ideally be 1.0)
EMAIL_WEIGHT=0.30
URL_WEIGHT=0.30
DOMAIN_WEIGHT=0.20
WEBPAGE_WEIGHT=0.20

# Risk Thresholds (0-100)
SAFE_THRESHOLD=30
SUSPICIOUS_THRESHOLD=65

# Data Retention
STORE_RAW_EMAIL=false
RETENTION_DAYS=30
# Screenshot evidence is purged on its own, shorter clock than the analysis
# record. 0 = store no screenshots at all. The sweep runs at startup and every
# VISUAL_PURGE_INTERVAL_MINUTES; set VISUAL_AUTO_PURGE_ENABLED=false to disable.
VISUAL_RETENTION_DAYS=7
VISUAL_PURGE_INTERVAL_MINUTES=360
VISUAL_AUTO_PURGE_ENABLED=true
# off | pixels | wireframe
VISUAL_SCREENSHOT_MODE=pixels
VISUAL_SCREENSHOT_MAX_WIDTH=480

# Limits
MAX_REQUEST_BYTES=2000000
MAX_FETCH_BYTES=3000000

# Cross-origin origins allowed to call the API. The default permits browser
# extensions, loopback and private (RFC 1918) LAN hosts, so a dashboard opened
# from another device on the network can reach the backend. A public origin is
# refused, so an internet page cannot use this backend as a scanning service.
# Narrow it to one address once LAN access is no longer needed:
# CORS_ORIGIN_REGEX=^https?://10\.140\.125\.196(:8080)?$

# Brand Protection (comma separated)
BRAND_LIST=paypal,microsoft,apple,google,amazon,facebook,netflix,bankofamerica,chase,wellsfargo,dropbox,linkedin,instagram,docusign,adobe,outlook,office365
ALLOWED_SCHEMES=http,https
